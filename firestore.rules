rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Islands: 誰でも読み取り・更新可（認証なしのため緩和）
    // Note: 本番環境ではFirebase Anonymous Authを導入して厳密化を推奨
    match /islands/{islandId} {
      allow read: if true;
      allow update: if true;
      allow create: if false; // 島の作成は管理者のみ
    }

    // Battles: 誰でも作成・更新可（認証なしのため緩和）
    // Note: 本番環境ではFirebase Anonymous Authを導入して厳密化を推奨
    match /battles/{battleId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    // Signaling: シグナリングデータ
    match /signaling/{battleId} {
      allow read, write: if true;

      match /iceCandidates/{candidateId} {
        allow read, write: if true;
      }
    }
  }
}
